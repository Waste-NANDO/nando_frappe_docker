# Main (prod) stack — port 3000, Compose project "erpnext-main".
# Shared pins: nando-deployment/versions.env. Prod receives the identical image
# promoted from cloud-dev (nando promote), not a separate rebuild.
ERPNEXT_VERSION=v16.5.0
FRAPPE_BRANCH=version-16
FRAPPE_VERSION=v16.28.0
DB_PASSWORD=CHANGE_ME_MAIN_DB_PASSWORD

COMPOSE_PROJECT_NAME=erpnext-main
COMPOSE_FILE_OUTPUT=nando-deployment/erpnext-main.yaml
TRAEFIK_ROUTER_PREFIX=erpnext-main
TRAEFIK_HOST_RULE='Host(`apps.internal.nandoai.com`)'

FRAPPE_SITE_NAME_HEADER=apps.internal.nandoai.com
FRAPPE_HOST_NAME=https://apps.internal.nandoai.com:3000
HTTPS_PUBLISH_PORT=3000

GCS_BUCKET=nando-it-backups
APP_NAME=nando-erp-main
# Daily scheduled backup with files; keep ~14 locally before GCS lifecycle.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

INCLUDE_CUSTOM_APP=yes
CUSTOM_APP_KEYS=nando_crm,nando_fulfillment
SITE_INSTALL_APPS=nando_crm,nando_fulfillment

NANDO_CRM_REPO=https://github.com/Waste-NANDO/nando-erp-crm.git
NANDO_CRM_BRANCH=main

NANDO_FULFILLMENT_REPO=https://github.com/Waste-NANDO/nando-erpnext-module.git
NANDO_FULFILLMENT_BRANCH=master

INCLUDE_HRMS=yes
HRMS_REPO=https://github.com/frappe/hrms.git
HRMS_BRANCH=v16.5.0

# Prod image name; promote retags the validated cloud-dev image to this name/tag.
CUSTOM_IMAGE=nando-erpnext-main
CUSTOM_TAG=v16.5.0-frappe-16.28-prod
PULL_POLICY=never

BUILD_ASSETS_IN_IMAGE=yes
BENCH_BUILD_NODE_MEMORY_MB=6144
BUILD_HRMS_FULL=0
