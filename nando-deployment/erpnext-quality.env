# Quality stack — port 3001, Compose project "erpnext-quality".
# Hotfix / UAT lane between cloud-dev and prod. Shared pins: versions.env.
ERPNEXT_VERSION=v16.5.0
FRAPPE_BRANCH=version-16
FRAPPE_VERSION=v16.28.0
DB_PASSWORD=CHANGE_ME_QUALITY_DB_PASSWORD

COMPOSE_PROJECT_NAME=erpnext-quality
COMPOSE_FILE_OUTPUT=nando-deployment/erpnext-quality.yaml
TRAEFIK_ROUTER_PREFIX=erpnext-quality
TRAEFIK_HOST_RULE='Host(`apps.internal.nandoai.com`)'

FRAPPE_SITE_NAME_HEADER=apps.internal.nandoai.com
FRAPPE_HOST_NAME=https://apps.internal.nandoai.com:3001
HTTPS_PUBLISH_PORT=3001

GCS_BUCKET=nando-it-backups
APP_NAME=nando-erp-quality
# No scheduled GCS upload; keep a few local backups only.
BACKUP_INTERVAL_SECONDS=0
BACKUP_KEEP=3

INCLUDE_CUSTOM_APP=yes
CUSTOM_APP_KEYS=nando_crm,nando_fulfillment,nando_hr
SITE_INSTALL_APPS=nando_crm,nando_fulfillment,nando_hr

# Monorepo (nando-erp-modules) — both apps share one repo/branch.
NANDO_APPS_REPO=https://github.com/Waste-NANDO/nando-erp-modules.git
NANDO_APPS_BRANCH=quality

INCLUDE_HRMS=yes
HRMS_REPO=https://github.com/frappe/hrms.git
HRMS_BRANCH=v16.5.0

CUSTOM_IMAGE=nando-erpnext-quality
CUSTOM_TAG=v16.5.0-frappe-16.28-quality
PULL_POLICY=never

BUILD_ASSETS_IN_IMAGE=yes
BENCH_BUILD_NODE_MEMORY_MB=6144
BUILD_HRMS_FULL=0
