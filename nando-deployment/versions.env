# Shared version pins for local bench, cloud-dev, and prod.
# Source this file from erpnext-*.env and from `nando local-bootstrap` / `nando doctor`.
# Promote by building once on cloud-dev and retagging the identical image for prod.

ERPNEXT_VERSION=v16.5.0
# frappe/build and frappe/base Docker tag (major line only — not a git pin)
FRAPPE_BRANCH=version-16
# Frappe framework git tag for bench init / image build (required; do not use version-16)
FRAPPE_VERSION=v16.28.0

INCLUDE_HRMS=yes
HRMS_REPO=https://github.com/frappe/hrms.git
HRMS_BRANCH=v16.5.0

# Custom apps — branch for fetch; build records resolved commit SHAs into image labels.
NANDO_CRM_REPO=https://github.com/Waste-NANDO/nando-erp-crm.git
NANDO_FULFILLMENT_REPO=https://github.com/Waste-NANDO/nando-erpnext-module.git

# Image name family (env files still set CUSTOM_IMAGE / CUSTOM_TAG per stack).
CUSTOM_IMAGE_FAMILY=nando-erpnext
